<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net481;net9.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HAgent.WinForms</AssemblyName>
    <RootNamespace>HAgent.WinForms</RootNamespace>
    <PackageId>HAgent.WinForms</PackageId>
    <Version>0.1.8</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HAgent.Core\HAgent.Core.csproj" />
    <ProjectReference Include="..\HAgent.Providers.OpenAICompatible\HAgent.Providers.OpenAICompatible.csproj" />
    <ProjectReference Include="..\HAgent.Storage.File\HAgent.Storage.File.csproj" />
    <ProjectReference Include="..\HAgent.Storage.SqlServer\HAgent.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\HAgent.Storage.MySql\HAgent.Storage.MySql.csproj" />
  </ItemGroup>
</Project>
